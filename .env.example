# ==================== Telegram ====================
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата/канала, куда бот шлёт алерты и откуда принимает команды
# Узнать можно у @userinfobot или @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here


# ==================== Мониторинг ====================
# Интервал опроса Bybit REST API (в секундах). Не используется при WS.
POLL_INTERVAL=4

# [LEGACY] Порог объёма в %. Пока не используется в Monitor,
# логика вынесена в CANDLE_VOLUME_MULTIPLIER.
VOLUME_THRESHOLD=5.0

# [LEGACY] Кулдаун для volume-алертов в секундах.
VOLUME_COOLDOWN=300


# ==================== Анализ свечей ====================
# Таймфрейм для анализа паттернов/RSI (формат Bybit: 1, 3, 5, 15, 30, 60, 120, 240, 360, 720, D, W)
CANDLE_INTERVAL=15

# Сколько свечей усреднять для расчёта объёма (обычно 20)
CANDLE_PERIODS=20

# Во сколько раз объём должен превысить средний, чтобы считаться всплеском
CANDLE_VOLUME_MULTIPLIER=3.0


# ==================== Кулдауны алертов ====================
# Сколько минут не повторять один и тот же алерт (по ключу symbol+price+direction)
ALERT_COOLDOWN_MINUTES=5


# ==================== Логирование ====================
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================== WebSocket ====================
# Использовать WS-push для цен вместо REST-поллинга.
# true  — WS (рекомендуется)
# false — REST-поллинг каждые POLL_INTERVAL секунд (fallback)
USE_WEBSOCKET=true

# URL публичного WS Bybit v5 (linear). Менять не нужно.
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Задержка реконнекта (сек). Базовая, далее — экспоненциальный backoff до 30с.
WS_RECONNECT_DELAY=5

# Период ping'а (сек). Bybit требует не реже 20.
WS_PING_INTERVAL=20

# Период сверки подписок с alerts.json (сек).
WS_SYMBOL_REFRESH=10