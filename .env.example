# ==================== Telegram ====================
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата/канала, куда бот шлёт алерты и откуда принимает команды
# Узнать можно у @userinfobot или @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here


# ==================== Мониторинг ====================
# Интервал опроса Bybit REST API (в секундах). Не используется при WS.
POLL_INTERVAL=4

# [LEGACY] Порог объёма в %. Пока не используется в Monitor,
# логика вынесена в CANDLE_VOLUME_MULTIPLIER.
VOLUME_THRESHOLD=5.0

# [LEGACY] Кулдаун для volume-алертов в секундах.
VOLUME_COOLDOWN=300


# ==================== Анализ свечей ====================
# Таймфрейм для анализа паттернов/RSI (формат Bybit: 1, 3, 5, 15, 30, 60, 120, 240, 360, 720, D, W)
CANDLE_INTERVAL=15

# Сколько свечей усреднять для расчёта объёма (обычно 20)
CANDLE_PERIODS=20

# Во сколько раз объём должен превысить средний, чтобы считаться всплеском
CANDLE_VOLUME_MULTIPLIER=3.0


# ==================== Кулдауны алертов ====================
# Сколько минут не повторять один и тот же алерт (по ключу symbol+price+direction)
ALERT_COOLDOWN_MINUTES=25


# ==================== Логирование ====================
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================== WebSocket ====================
# Использовать WS-push для цен вместо REST-поллинга.
# true  — WS (рекомендуется)
# false — REST-поллинг каждые POLL_INTERVAL секунд (fallback)
USE_WEBSOCKET=true

# URL публичного WS Bybit v5 (linear). Менять не нужно.
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Задержка реконнекта (сек). Базовая, далее — экспоненциальный backoff до 30с.
WS_RECONNECT_DELAY=5

# Период ping'а (сек). Bybit требует не реже 20.
WS_PING_INTERVAL=20

# Период сверки подписок с alerts.json (сек).
WS_SYMBOL_REFRESH=10

# ==================== Risk-модуль ====================
EQUITY=10000
RISK_PCT=0.01
LOT_STEP=0.001
MIN_QTY=0.001
MAX_QTY=
ATR_MULTIPLIER=1.5
MIN_RUNWAY_ATR=2.0

# Слать ли алерты с hard filter (⛔ СДЕЛКА НЕ ПО СТРАТЕГИИ).
# false (по умолчанию) — только сетапы, прошедшие стратегию.
# true — отладочный режим: слать всё.
SEND_INVALID_ALERTS=false


# ==================== Runtime-настройки из чата ====================
# Порог score для отправки (alert_min_score), send_invalid_alerts, глубина
# истории, сканер уровней и виртуальные сделки хранятся в data/settings.json
# и меняются кнопками в Telegram. Здесь — только то, что читается из env.
#
# Пресеты кнопок (ALERT_SCORE_PRESETS, HISTORY_DEPTH_PRESETS,
# LEVEL_SCAN_HOURS_PRESETS, LEVEL_SCAN_SCORE_PRESETS, REVERSAL_MIN_N_PRESETS)
# заданы константами в src/utils/config.py — это правка кода, не env.

# ==================== Дневник разворотов ====================
# Включён ли дневник: писать pending, резолвить, показывать статистику.
REVERSAL_DIARY_ENABLED=true

# Писать ли исходы для слабых/hard-filter алертов (false — только «чистые»).
REVERSAL_RECORD_WEAK=false

# Сколько свечей 15m ждать до резолва (8 × 15m = 2 часа).
REVERSAL_LOOKAHEAD_BARS=8

# Ход в сторону алерта >= N x ATR_1h считается успехом.
REVERSAL_MIN_MOVE_ATR=1.0

# Стоп-зона: level +/- SL_BUFFER_ATR x ATR_1h.
REVERSAL_SL_BUFFER_ATR=0.5

# Порог n для строки «История: ...» в алерте.
REVERSAL_MIN_N_DISPLAY=15

# Pending без резолва дольше N часов -> expired.
REVERSAL_PENDING_TIMEOUT_HOURS=48

# Интервал между проходами resolve_all_pending (минуты).
REVERSAL_RESOLVE_INTERVAL_MIN=20

# ==================== Виртуальный трейдер ====================
VIRTUAL_TRADER_ENABLED=true

# Как часто пересчитывать открытые виртуальные сделки (минуты).
VIRTUAL_TRADER_RESOLVE_INTERVAL_MIN=5

# Риск на виртуальную сделку в USDT (бумажный, реальных ордеров нет).
VIRTUAL_TRADER_DEFAULT_RISK=1.0
